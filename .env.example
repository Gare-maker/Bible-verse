# Optional Supabase Cloud Sync Configuration
# (When omitted, the application automatically persists all research notes, connections,
# collections, bookmarks, highlights, and reading history locally + via Cloud Sync JSON bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional LLM API Key for Server-Side AI Research Route (/api/ai-research)
OPENAI_API_KEY=
GEMINI_API_KEY=

